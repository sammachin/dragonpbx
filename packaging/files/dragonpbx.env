# DragonPBX runtime environment — sourced by dragonpbx.service (and the
# drachtio/rtpengine units). Variable names match app/settings.js.
# Edit on the target host after install; this is a dpkg conffile so your
# changes survive upgrades.

# --- drachtio (control connection) ---
DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
DRACHTIO_SECRET=cymru

# --- rtpengine (NG control) — matches rtpengine.service --listen-ng ---
RTPENGINE_HOST=127.0.0.1
RTPENGINE_PORT=22222

# --- redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- app HTTP/API + logging ---
WEBPORT=2999
LOGLEVEL=info

# --- data source ---
# 'api' (default): fetch domain config from CONFIG_URL. Otherwise the app uses
# the Postgres settings below.
DATA_SOURCE=api
CONFIG_URL=http://127.0.0.1:1337/api/v1/domains
CONFIG_TOKEN=
CONFIG_TTL=60

# --- Postgres (only used when DATA_SOURCE is not 'api') ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme

# --- Networking for the drachtio/rtpengine units ---
# Leave blank to auto-detect the primary IPv4 (hostname -I). Set explicitly on
# multi-homed / NAT'd hosts (PUBLIC_IP = externally reachable address).
LOCAL_IP=
PUBLIC_IP=
